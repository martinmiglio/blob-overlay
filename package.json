{
  "name": "blob-overlay",
  "version": "0.0.0",
  "description": "Layered object storage for preview environments.",
  "license": "MIT",
  "author": "Martin Miglio",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./r2": {
      "types": "./dist/r2.d.ts",
      "import": "./dist/r2.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example": "bun examples/preview.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "r2",
    "cloudflare",
    "object-storage",
    "overlay",
    "copy-on-write",
    "preview-environments"
  ],
  "peerDependencies": {
    "effect": "^4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@effect/vitest": "4.1.2",
    "@types/node": "^26.6.6",
    "effect": "4.1.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
