{
  "name": "@martinmiglio/blob-overlay",
  "version": "0.1.0",
  "description": "Layered object storage for preview environments.",
  "license": "MIT",
  "author": "Martin Miglio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinmiglio/blob-overlay.git"
  },
  "homepage": "https://github.com/martinmiglio/blob-overlay#readme",
  "bugs": {
    "url": "https://github.com/martinmiglio/blob-overlay/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./r2": {
      "types": "./src/r2.ts",
      "import": "./src/r2.ts",
      "default": "./src/r2.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example": "bun examples/preview.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "r2",
    "cloudflare",
    "object-storage",
    "overlay",
    "copy-on-write",
    "preview-environments",
    "effect"
  ],
  "peerDependencies": {
    "effect": "^4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@effect/vitest": "4.1.2",
    "@types/node": "^26.6.6",
    "effect": "4.1.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
